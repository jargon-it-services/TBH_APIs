{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=thebeautyhub;Username=postgres;Password=admin123"
  },
  "JwtSettings": {
    "SecretKey": "DevelopmentSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "AuthCenter-Dev",
    "Audience": "AuthCenterClients-Dev",
    "AccessTokenExpirationMinutes": 60
  },
  "AuthCenter": {
    "BaseUrl": "http://127.0.0.1:5070",
    "ValidatePath": "/api/auth/validate",
    "ProfilePath": "/api/user/profile",
    "ApplicationName": "The Beauty Hub",
    "ValidateWithAuthCenter": true,
    "ValidateCacheSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
